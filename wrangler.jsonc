// Cloudflare hosting for the web build (https://huntr.online).
// Deploy with tool/deploy_web.sh.
{
  "name": "huntr",
  "compatibility_date": "2026-10-01",
  "routes": [
    { "pattern": "huntr.online", "custom_domain": true },
    { "pattern": "www.huntr.online", "custom_domain": true }
  ],
  // keep https://huntr.marklibres345.workers.dev working too
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./build/web",
    "not_found_handling": "single-page-application"
  }
}
