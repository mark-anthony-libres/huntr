{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Connect phone (wireless debugging)",
      "detail": "adb connect (asks for the port only if needed) + adb reverse tcp:18000",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/tool/connect_phone.ps1"
      ],
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Stop web debug (free port 7357)",
      "detail": "Stops a Chrome debug run still on port 7357 (and its Chrome), when VS Code shows no Stop button",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/tool/free_web_port.ps1"
      ],
      "presentation": { "reveal": "silent", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    }
  ]
}
